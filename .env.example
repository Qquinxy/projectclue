# Base URL of the backend API (without a trailing slash before /api).
# http://localhost:5000/api locally; https://your-domain.com/api in production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Show the Google (Clerk) sign-in / sign-up button.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true

# Clerk publishable key — from Dashboard → API Keys. Public, safe in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxx